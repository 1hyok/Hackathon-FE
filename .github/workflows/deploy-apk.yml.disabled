name: Build and Deploy APK

on:
  push:
    branches:
      - main

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
          cache: 'gradle'

      - name: Grant execute permission for gradlew
        run: chmod +x ./gradlew

      - name: Create google-services.json
        env:
          GOOGLE_SERVICES_JSON: ${{ secrets.GOOGLE_SERVICES_JSON }}
        run: |
          # Base64 디코딩 (줄바꿈 제거 후 디코딩)
          echo "$GOOGLE_SERVICES_JSON" | tr -d '\n' | base64 --decode > app/google-services.json
          
          # 파일 생성 확인
          if [ ! -f app/google-services.json ]; then
            echo "❌ google-services.json 파일 생성 실패!"
            exit 1
          fi
          
          # JSON 유효성 검증 (기본 확인)
          if ! cat app/google-services.json | grep -q '"project_info"'; then
            echo "❌ google-services.json 파일이 유효한 JSON 형식이 아닙니다!"
            exit 1
          fi
          
          echo "✅ google-services.json 파일 생성 완료"

      - name: Build Debug APK
        run: ./gradlew assembleDebug --stacktrace --info

      - name: Get commit message
        id: commit
        run: |
          echo "MESSAGE=$(git log -1 --pretty=%s)" >> $GITHUB_OUTPUT
          echo "SHORT_SHA=$(git rev-parse --short HEAD)" >> $GITHUB_OUTPUT

      - name: Verify Firebase Secrets
        run: |
          echo "🔍 Checking Firebase Secrets..."
          if [ -z "${{ secrets.FIREBASE_APP_ID }}" ]; then
            echo "❌ FIREBASE_APP_ID is not set!"
            exit 1
          else
            echo "✅ FIREBASE_APP_ID is set"
          fi
          
          if [ -z "${{ secrets.FIREBASE_TOKEN }}" ]; then
            echo "❌ FIREBASE_TOKEN is not set!"
            echo "⚠️  Please add FIREBASE_TOKEN secret with Firebase service account JSON"
            exit 1
          else
            echo "✅ FIREBASE_TOKEN is set"
            # JSON 형식 기본 확인 (type: service_account 포함 여부)
            if echo "${{ secrets.FIREBASE_TOKEN }}" | grep -q '"type".*"service_account"'; then
              echo "✅ FIREBASE_TOKEN appears to be a valid service account JSON"
            else
              echo "⚠️  WARNING: FIREBASE_TOKEN may not be a valid service account JSON"
              echo "   Expected format: { \"type\": \"service_account\", ... }"
            fi
          fi

      - name: Upload to Firebase App Distribution
        id: firebase_distribution
        uses: wzieba/Firebase-Distribution-Github-Action@v1
        with:
          appId: ${{ secrets.FIREBASE_APP_ID }}
          # serviceCredentialsFileContent: Firebase 서비스 계정 JSON 파일의 전체 내용이 필요합니다
          # GitHub Secrets에 저장된 값은 다음 형식이어야 합니다:
          # {
          #   "type": "service_account",
          #   "project_id": "your-project-id",
          #   "private_key": "...",
          #   "client_email": "...",
          #   ...
          # }
          # Secret 이름이 FIREBASE_SERVICE_ACCOUNT_JSON인 경우, 아래를 FIREBASE_SERVICE_ACCOUNT_JSON으로 변경하세요
          serviceCredentialsFileContent: ${{ secrets.FIREBASE_TOKEN }}
          groups: testers
          file: app/build/outputs/apk/debug/app-debug.apk
          releaseNotes: |
            새 버전이 배포되었습니다!
            커밋: ${{ steps.commit.outputs.SHORT_SHA }}
            메시지: ${{ steps.commit.outputs.MESSAGE }}

      - name: Send Discord notification
        uses: rjstone/discord-webhook-notify@v1
        if: success()
        with:
          severity: info
          webhookUrl: REDACTED_DISCORD_WEBHOOK/github
          text: |
            🚀 새 APK가 배포되었습니다!
            
            **버전:** ${{ steps.commit.outputs.SHORT_SHA }}
            **커밋:** ${{ steps.commit.outputs.MESSAGE }}
            **작성자:** ${{ github.actor }}
            
            📥 **다운로드:**
            Firebase 콘솔에서 최신 버전을 다운로드하세요:
            https://console.firebase.google.com/project/drzubzub-594aa/appdistribution/app/1:1017615947344:android:9a6380798488227ca4e355/distributors
            
            또는 Firebase App Tester 앱을 설치하고 알림을 확인하세요.

      - name: Send Discord notification on failure
        uses: rjstone/discord-webhook-notify@v1
        if: failure()
        with:
          severity: error
          webhookUrl: REDACTED_DISCORD_WEBHOOK/github
          text: |
            APK 빌드 실패!
            작성자: ${{ github.actor }}
